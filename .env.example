# Claré AI — backend environment
# Copy to .env for local dev. In production set these in the host's dashboard
# (Railway/Render), NEVER by committing a .env file.

# ── Database ──────────────────────────────────────────────
# Use a SEPARATE Atlas database for production — not the dev one.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/clare-ai

# ── Secrets ───────────────────────────────────────────────
# Generate fresh values for production: node test/generateSecrets.js
# Rotating JWT_SECRET logs every admin out, which is the point when moving
# from dev to prod — dev tokens must not work against production.
JWT_SECRET=change-me-before-deploy
SETUP_SECRET=change-me-before-deploy

# ── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────
PORT=5000

# Comma-separated origins allowed in addition to each brand's allowedOrigins.
# In production: your three subdomains.
# CORS_ORIGINS=https://admin.yourdomain.com,https://dashboard.yourdomain.com,https://scan.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Number of proxy hops to trust for the client IP. Railway/Render sit behind
# exactly one, so set 1 there. Leave UNSET locally — trusting a forwarded IP
# with no proxy in front lets a client spoof it and bypass rate limiting.
# TRUST_PROXY=1
